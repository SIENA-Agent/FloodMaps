.venv/
__pycache__/
*.pyc
.DS_Store
*.egg-info/

# Local source GeoTIFFs — never in git
geotiffs/*.tif
geotiffs/*.tiff

# Build outputs (scripts/build.sh) — folder READMEs stay in git
data/*
!data/README.md
!data/.gitkeep

docs/*
!docs/README.md
!docs/.gitkeep

scripts/Zaratan/env.config.local.sh
logs/
floodmaps_build_*.out
