# Copy to ~/.config/floodmaps/credentials.env (outside the repo — never commit).
#
#   mkdir -p ~/.config/floodmaps
#   cp scripts/Zaratan/credentials.env.example ~/.config/floodmaps/credentials.env
#   chmod 600 ~/.config/floodmaps/credentials.env
#   # edit and paste your fine-grained PAT below
#
# Required PAT permissions on SIENA-Agent/FloodMaps:
#   Contents: Read and write
#   Actions:  Read and write

export GITHUB_TOKEN='github_pat_REPLACE_ME'
